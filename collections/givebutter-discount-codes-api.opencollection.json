{
  "opencollection": "1.0.0",
  "info": {
    "name": "Givebutter Campaigns Discount Codes API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Discount Codes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List discount codes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.givebutter.com/v1/discount-codes"
          },
          "docs": "List discount codes"
        },
        {
          "info": {
            "name": "Create a discount code",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.givebutter.com/v1/discount-codes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a discount code"
        }
      ]
    }
  ],
  "bundled": true
}